{
  "name": "myfocus",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "dev:front": "npm --workspace apps/frontend run dev",
    "dev:back": "npm --workspace apps/backend run dev",
    "build:all": "npm --workspace apps/frontend run build && npm --workspace apps/backend run build",
    "prod": "concurrently \"npm run prod:back\" \"npm run prod:front\"",
    "prod:front": "npm --workspace apps/frontend run prod",
    "prod:back": "npm --workspace apps/backend run prod",
    "prisma:migrate": "npm --workspace apps/backend run migrate",
    "prisma:generate": "npm --workspace apps/backend run generate",
    "setup": "npm install --workspaces && npm run prisma:migrate && npm run prisma:generate"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  }
}
